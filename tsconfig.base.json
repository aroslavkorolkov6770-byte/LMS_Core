{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lms-core/shared": ["packages/shared/src/index.ts"],
      "@lms-core/db": ["packages/db/src"],
      "@lms-core/config": ["packages/config/src"]
    }
  }
}
