# Shared project settings
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_core

# Redis
REDIS_URL=redis://localhost:6379

# Storage
S3_ENDPOINT=https://example-storage.local
S3_REGION=ru-central-1
S3_BUCKET=lms-core-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Auth
SESSION_SECRET=replace-me

# AI
AI_PROVIDER=replace-me
AI_API_KEY=replace-me

# Notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me

# Web Push
WEB_PUSH_PUBLIC_KEY=replace-me
WEB_PUSH_PRIVATE_KEY=replace-me
